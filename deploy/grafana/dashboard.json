  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 10,
      "type": "timeseries",
      "title": "P50 窗口延迟",
      "description": "在选中的单个探测窗口内，按日志源计算 P50。",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "auto",
            "pointSize": 5,
            "spanNulls": false,
            "fillOpacity": 5
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sre_aiobs_window_latency_seconds{source=~\"${source:regex}\",kind=\"$kind\",quantile=\"0.50\"}",
          "legendFormat": "{{source}}",
          "refId": "A",
          "range": true
        }
      ]
    },
