  "refresh": "1m",
  "schemaVersion": 39,
  "tags": [
    "sre-aiobs",
    "victoriametrics"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "SRE AIObs · 延迟与异常",
  "uid": "sre-aiobs",
  "version": 2,
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "type": "datasource",
        "label": "指标数据源",
        "query": "prometheus",
        "current": {
          "text": "VictoriaMetrics",
          "value": "victoriametrics"
        },
        "refresh": 1
      },
      {
        "name": "source",
        "type": "query",
        "label": "日志源",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "query": {
          "query": "label_values(sre_aiobs_window_logs, source)",
          "refId": "source"
        },
        "definition": "label_values(sre_aiobs_window_logs, source)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "kind",
        "type": "custom",
        "label": "窗口粒度",
        "query": "minute,five_minutes,hour,day",
        "options": [
          {
            "selected": false,
            "text": "minute",
            "value": "minute"
          },
          {
            "selected": true,
            "text": "five_minutes",
            "value": "five_minutes"
          },
          {
            "selected": false,
            "text": "hour",
            "value": "hour"
          },
          {
            "selected": false,
            "text": "day",
            "value": "day"
          }
        ],
        "current": {
          "text": "five_minutes",
          "value": "five_minutes"
        }
      }
    ]
  }
}
