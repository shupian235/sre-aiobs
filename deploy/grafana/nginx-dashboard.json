    {
      "id": 6,
      "title": "QPS / RPS（每分钟平均）",
      "description": "每个对齐的一分钟桶的请求数除以 60。范围两端的部分分钟可能低估。",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "nginx-elasticsearch"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "nginx-elasticsearch"
          },
          "query": "${traffic_filter:raw}",
          "timeField": "@timestamp",
          "bucketAggs": [
            {
              "id": "30",
              "type": "date_histogram",
              "field": "@timestamp",
              "settings": {
                "interval": "1m",
                "min_doc_count": "0",
                "trimEdges": "0"
              }
            }
          ],
          "metrics": [
            {
              "id": "1",
              "type": "count",
              "hide": true
            },
            {
              "id": "2",
              "type": "bucket_script",
              "settings": {
                "script": "params.requests / 60.0"
              },
              "pipelineVariables": [
                {
                  "name": "requests",
                  "pipelineAgg": "1"
                }
              ]
            }
          ]
        }
      ]
    },
