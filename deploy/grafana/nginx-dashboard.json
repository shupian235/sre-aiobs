        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "elasticsearch",
        "uid": "nginx-elasticsearch"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "elasticsearch",
            "uid": "nginx-elasticsearch"
          },
          "query": "${traffic_filter:raw}",
          "timeField": "@timestamp",
          "bucketAggs": [
            {
              "id": "20",
              "type": "filters",
              "settings": {
                "filters": [
                  {
                    "label": "全部",
                    "query": "*"
                  }
                ]
              }
            }
          ],
          "metrics": [
            {
              "id": "1",
              "type": "count"
            }
          ]
